<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <application
        android:allowBackup="true"
        android:label="FoodHub"
        android:theme="@style/Theme.FoodHub"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <activity android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".ui.auth.SignUpActivity"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.home.MainActivity"/>
        <activity android:name=".ui.account.AccountActivity"/>
        <activity android:name=".ui.account.UserInfoActivity"/>
        <activity android:name=".ui.address.AddressActivity"/>
        <activity android:name=".ui.settings.SettingsActivity"/>
        <activity android:name=".ui.voucher.VoucherActivity"/>
        <activity android:name=".ui.restaurant.RestaurantDetailActivity"/>
        <activity android:name=".ui.product.ProductDetailActivity"/>
        <activity android:name=".ui.order.OrderDetailActivity"/>
        <activity android:name=".ui.cart.CartActivity"/>
        <activity android:name=".ui.checkout.CheckoutActivity"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Các màn hình Quản trị Admin -->
        <activity android:name=".ui.admin.AdminFoodActivity"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.admin.AdminCategoryActivity"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.admin.AdminOrderActivity"
            android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.admin.AdminRevenueActivity"
            android:windowSoftInputMode="adjustResize"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
