<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_grey">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="1dp"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back_dark"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="Danh mục &amp; Nhà hàng"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btnAddItem"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ Thêm"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_red"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Segmented Tab Controls (Material 3 / iOS style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_tab_segment_bg"
        android:padding="3dp">

        <!-- Tab 1: Danh mục món -->
        <TextView
            android:id="@+id/tabCategory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Danh mục món"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:background="@drawable/bg_tab_segment_selected"
            android:elevation="1dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Tab 2: Nhà hàng & Quán -->
        <TextView
            android:id="@+id/tabRestaurant"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Nhà hàng &amp; Quán"
            android:textSize="13.5sp"
            android:textColor="#64748B"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Counter & Subtitle -->
    <TextView
        android:id="@+id/tvCountSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:text="Tổng số: 6 danh mục món ăn"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <!-- Content Containers -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Category List Container -->
            <LinearLayout
                android:id="@+id/llCategoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible" />

            <!-- Restaurant List Container -->
            <LinearLayout
                android:id="@+id/llRestaurantContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
