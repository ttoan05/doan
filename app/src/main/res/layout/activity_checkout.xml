<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_grey">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:padding="16dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textSize="28sp"
            android:textColor="#333333"
            android:paddingEnd="12dp"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đặt hàng"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:gravity="center"/>
        <View android:layout_width="34dp" android:layout_height="1dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Cảnh báo nhiều nhà hàng -->
            <LinearLayout
                android:id="@+id/llMultiRestaurantWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FEF3C7"
                android:padding="12dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚠️ Lưu ý về phí giao hàng"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#B45309"/>

                    <TextView
                        android:id="@+id/btnCloseWarning"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="✕"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#B45309"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMultiRestaurantWarningText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textColor="#92400E"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <!-- Thông tin giao hàng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Thông tin giao hàng"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"/>

                    <TextView
                        android:id="@+id/btnPickSavedAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Chọn sổ địa chỉ"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/red_primary"
                        android:padding="4dp"/>
                </LinearLayout>

                <EditText
                    android:id="@+id/etReceiver"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_field"
                    android:hint="Tên người nhận"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_field"
                    android:hint="Số điện thoại"
                    android:inputType="phone"
                    android:imeOptions="actionNext"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:background="@drawable/bg_field"
                    android:hint="Địa chỉ giao hàng"
                    android:inputType="textCapSentences|textMultiLine"
                    android:imeOptions="actionDone"
                    android:gravity="top"
                    android:padding="14dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="8dp"/>

                <CheckBox
                    android:id="@+id/cbSaveAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lưu địa chỉ này vào sổ địa chỉ quen thuộc"
                    android:textSize="13sp"
                    android:buttonTint="@color/red_primary"
                    android:textColor="@color/text_grey2"/>
            </LinearLayout>

            <!-- Ghi chú đơn hàng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📝 Ghi chú đơn hàng"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etOrderNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:background="@drawable/bg_field"
                    android:hint="Ghi chú cho nhà hàng hoặc tài xế (vd: Giao trước 12h, mang thêm thìa đũa...)"
                    android:inputType="textCapSentences|textMultiLine"
                    android:gravity="top"
                    android:padding="12dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_dark"/>
            </LinearLayout>

            <!-- Mã giảm giá (Voucher) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🎟️ Mã giảm giá (Voucher)"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"/>

                    <TextView
                        android:id="@+id/btnPickVoucher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chọn mã voucher"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/red_primary"
                        android:padding="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etVoucherCode"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field"
                        android:hint="Nhập mã voucher (vd: FIRST30)"
                        android:inputType="textCapCharacters"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark"/>

                    <Button
                        android:id="@+id/btnApplyVoucher"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_btn_red"
                        android:backgroundTint="@null"
                        android:text="Áp dụng"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                </LinearLayout>

                <!-- Dòng hiển thị mã đã áp dụng -->
                <LinearLayout
                    android:id="@+id/llAppliedVoucher"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:background="#F0FDF4"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvAppliedVoucherDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Đã áp dụng mã"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#16A34A"/>

                    <TextView
                        android:id="@+id/btnRemoveVoucher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hủy mã"
                        android:textSize="12sp"
                        android:textColor="@color/red_primary"
                        android:padding="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Phương thức thanh toán -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phương thức thanh toán"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="4dp"/>

                <RadioGroup
                    android:id="@+id/rgPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbCod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:buttonTint="@color/red_primary"
                        android:text="💵  Thanh toán khi nhận hàng (COD)"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"/>

                    <RadioButton
                        android:id="@+id/rbMomo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/red_primary"
                        android:text="📱  Ví MoMo"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"/>

                    <!-- MoMo QR Preview Card -->
                    <LinearLayout
                        android:id="@+id/llMomoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="30dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_field"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📱 Ví MoMo: 0867656271 - TRUONG THANH TOAN"
                            android:textColor="#9D174D"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Quét mã QR MoMo hoặc VietQR nhanh 24/7"
                            android:textColor="#64748B"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/btnViewMomoQr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_tag_momo"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="Xem mã QR MoMo thanh toán"
                            android:textColor="#9D174D"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rbBank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/red_primary"
                        android:text="🏦  Chuyển khoản ngân hàng"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"/>

                    <!-- Bank VietQR Preview Card -->
                    <LinearLayout
                        android:id="@+id/llBankPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="30dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_field"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏦 MB Bank: 0867656271 - TRUONG THANH TOAN"
                            android:textColor="#1E40AF"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="MB Bank • Quét VietQR nhanh Napas 24/7"
                            android:textColor="#64748B"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/btnViewBankQr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_tag_bank"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="Xem mã QR chuyển khoản ngân hàng"
                            android:textColor="#1E40AF"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RadioGroup>
            </LinearLayout>

            <!-- Tóm tắt đơn hàng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tóm tắt đơn hàng"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/llCheckoutItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/divider"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tạm tính"
                        android:textSize="14sp"
                        android:textColor="@color/text_grey2"/>
                    <TextView
                        android:id="@+id/tvCheckoutSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Phí giao hàng"
                        android:textSize="14sp"
                        android:textColor="@color/text_grey2"/>
                    <TextView
                        android:id="@+id/tvCheckoutShipping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"/>
                </LinearLayout>

                <!-- Dòng giảm giá voucher -->
                <LinearLayout
                    android:id="@+id/llCheckoutDiscountRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tvCheckoutDiscountLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Giảm giá voucher"
                        android:textSize="14sp"
                        android:textColor="#16A34A"/>
                    <TextView
                        android:id="@+id/tvCheckoutDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#16A34A"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng tiền"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"/>
                    <TextView
                        android:id="@+id/tvCheckoutTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/red_primary"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:padding="12dp">
        <Button
            android:id="@+id/btnConfirmOrder"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_red"
            android:backgroundTint="@null"
            android:text="Xác nhận đặt hàng"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>
    </LinearLayout>
</LinearLayout>
