<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Ảnh nền món ăn full màn hình -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_auth_food"
        android:scaleType="centerCrop"
        android:contentDescription="Hình nền món ăn"/>

    <!-- Lớp phủ bóng mờ nhẹ để các badge phía trên dễ đọc -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#26000000"/>

    <!-- Nội dung cuộn -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="36dp"
            android:paddingBottom="20dp">

            <!-- Thanh Badge trên cùng -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <!-- Badge bên trái: FoodHub -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentStart="true"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_translucent"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="FoodHub"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:letterSpacing="0.02"/>

                <!-- Badge bên phải: Giao món nóng 20 phút -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_translucent"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Giao món nóng 20 phút"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="normal"/>
            </RelativeLayout>

            <!-- Khoảng trống để lộ hình ảnh món ăn hấp dẫn ở phần trên -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="100dp"/>

            <!-- Khung Card tròn nổi màu kem ấm (Floating Card) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_auth"
                android:elevation="8dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đăng nhập"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/auth_text_dark"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Truy cập tài khoản của bạn"
                    android:textSize="14sp"
                    android:textColor="@color/auth_text_grey"
                    android:gravity="center"
                    android:layout_marginBottom="24dp"/>

                <!-- Label Email -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="@color/auth_text_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="example@email.com"
                    android:textColorHint="#A69B93"
                    android:textColor="@color/auth_text_dark"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext"
                    android:background="@drawable/bg_field_warm"
                    android:textSize="15sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvEmailError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red_primary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp"/>

                <!-- Label Mật khẩu -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mật khẩu"
                    android:textColor="@color/auth_text_label"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="4dp">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="••••••••"
                        android:textColorHint="#A69B93"
                        android:textColor="@color/auth_text_dark"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:background="@drawable/bg_field_warm"
                        android:textSize="15sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="48dp"/>

                    <ImageView
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|center_vertical"
                        android:padding="12dp"
                        android:src="@drawable/ic_eye_invisible"
                        android:contentDescription="Ẩn hiện mật khẩu"
                        app:tint="@color/auth_text_grey"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPasswordError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red_primary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"/>

                <!-- Ghi nhớ tôi + Quên mật khẩu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp">

                    <CheckBox
                        android:id="@+id/cbRemember"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ghi nhớ tôi"
                        android:textSize="13sp"
                        android:textColor="#54473F"
                        android:buttonTint="@color/auth_terracotta"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/tvForgot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quên mật khẩu?"
                        android:textColor="@color/auth_terracotta"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"/>
                </LinearLayout>

                <!-- Nút ĐĂNG NHẬP -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="ĐĂNG NHẬP"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_terracotta"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:layout_marginBottom="18dp"/>

                <!-- Phân cách "Hoặc tiếp tục với" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/auth_field_stroke"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hoặc tiếp tục với"
                        android:textSize="12sp"
                        android:textColor="@color/auth_text_grey"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/auth_field_stroke"/>
                </LinearLayout>

                <!-- Nút Đăng nhập Mạng xã hội (Google & Facebook) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:id="@+id/btnGoogleLogin"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_social"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_google"
                            android:contentDescription="Google"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Google"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/auth_text_dark"/>
                    </LinearLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp"/>

                    <LinearLayout
                        android:id="@+id/btnFacebookLogin"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/bg_btn_social"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_facebook"
                            android:contentDescription="Facebook"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Facebook"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/auth_text_dark"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Link Đăng kí ngay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa có tài khoản? "
                        android:textSize="13sp"
                        android:textColor="@color/auth_text_grey"/>

                    <TextView
                        android:id="@+id/tvGoRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đăng kí ngay"
                        android:textColor="@color/auth_terracotta"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
