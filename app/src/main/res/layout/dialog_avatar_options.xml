<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="16dp">

    <!-- Nhóm tùy chọn chính bo tròn kiểu iOS Action Sheet -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_ios_action_group">

        <!-- Dòng 1: Thư viện ảnh -->
        <TextView
            android:id="@+id/btnOptionPickGallery"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="Thư viện ảnh"
            android:textColor="#007AFF"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <!-- Đường kẻ phân cách mờ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:background="#D1D1D6" />

        <!-- Dòng 2: Xóa ảnh đại diện -->
        <TextView
            android:id="@+id/btnOptionRemoveAvatar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="Xóa ảnh đại diện"
            android:textColor="#FF3B30"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

    <!-- Nút Thoát / Hủy tách rời bên dưới -->
    <TextView
        android:id="@+id/btnCancelAvatarDialog"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Thoát"
        android:textColor="#007AFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_ios_cancel_btn" />

</LinearLayout>
