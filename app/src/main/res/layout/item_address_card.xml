<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_address_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- House / Place Icon -->
    <ImageView
        android:id="@+id/ivAddressIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="Icon địa chỉ"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_house" />

    <!-- Address Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAddressLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhà"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAddressDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="cantho"
            android:textColor="#4B5563"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvReceiverInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Quản trị viên FoodHub • 1900 1234"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Delete / Trash Action -->
    <ImageView
        android:id="@+id/btnDeleteAddress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Xóa địa chỉ"
        android:focusable="true"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_trash" />

</LinearLayout>
