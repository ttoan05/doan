<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Category Thumbnail Photo -->
        <androidx.cardview.widget.CardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F5F9">

            <ImageView
                android:id="@+id/ivCategoryThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Ảnh danh mục" />

        </androidx.cardview.widget.CardView>

        <!-- Category Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvCategoryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cơm"
                android:textColor="#0F172A"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCategoryFoodCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 món ăn trong thực đơn"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <!-- Default badge for 'Tất cả' -->
        <TextView
            android:id="@+id/tvDefaultBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mặc định"
            android:textColor="#16A34A"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_status_green"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="gone" />

        <!-- Actions -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnEditCategory"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="Sửa"
                android:textColor="#2563EB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_action_edit_sleek"
                android:drawableStart="@drawable/ic_edit_blue"
                android:drawablePadding="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnDeleteCategory"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="Xóa"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_action_delete_sleek"
                android:drawableStart="@drawable/ic_delete_red"
                android:drawablePadding="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
