<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_menu_card"
    android:layout_marginBottom="12dp"
    android:padding="16dp"
    android:elevation="1dp">

    <!-- Top Row: Avatar + Name + ID + Badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar Circle -->
        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_avatar">

            <TextView
                android:id="@+id/tvCustomerAvatarLetter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="T"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCustomerAvatarPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Avatar" />

        </FrameLayout>

        <!-- Name + Customer Code -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trương Thanh Toàn"
                    android:textColor="#0F172A"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCustomerRoleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_admin"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="Admin"
                    android:textColor="#D97706"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCustomerCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mã KH: #KH001"
                android:textColor="#64748B"
                android:textSize="11.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Status Pill (Active / Locked) -->
        <TextView
            android:id="@+id/tvCustomerStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_status_green"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="● Hoạt động"
            android:textColor="#16A34A"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp" />

    <!-- Info Lines (Email, Phone, Address) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Phone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="📞"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCustomerPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0867656271"
                android:textColor="#334155"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="✉️"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCustomerEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="truongthanhtoan01012004@gmail.com"
                android:textColor="#334155"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Address -->
        <LinearLayout
            android:id="@+id/llCustomerAddressRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="📍"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCustomerAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chưa cập nhật địa chỉ"
                android:textColor="#64748B"
                android:textSize="12.5sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <!-- Orders Count Badge / Button -->
        <TextView
            android:id="@+id/btnViewOrders"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_normal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="📦 Đơn hàng"
            android:textColor="#2563EB"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Detail Button -->
        <TextView
            android:id="@+id/btnCustomerDetail"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_normal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text=" Chi tiết"
            android:textColor="#475569"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- Edit Button -->
        <TextView
            android:id="@+id/btnCustomerEdit"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_normal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text=" Sửa"
            android:textColor="#D97706"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- Lock / Unlock Button -->
        <TextView
            android:id="@+id/btnCustomerToggleLock"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/bg_chip_normal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text=" Khóa"
            android:textColor="#DC2626"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
