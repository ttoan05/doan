<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Banner + Overlay Badges -->
        <FrameLayout
            android:id="@+id/flRestaurantBanner"
            android:layout_width="match_parent"
            android:layout_height="120dp">

            <ImageView
                android:id="@+id/ivRestaurantBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Ảnh nhà hàng" />

            <!-- Promo badge -->
            <TextView
                android:id="@+id/tvRestaurantBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:background="#B3000000"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <!-- Rating badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="#E6FFFFFF"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_star_gold"
                    android:contentDescription="Sao" />

                <TextView
                    android:id="@+id/tvRestaurantRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="4.8"
                    android:textColor="#B45309"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

        <!-- Restaurant Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Name -->
            <TextView
                android:id="@+id/tvRestaurantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quán Phở Tuyệt"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Description / Cuisines -->
            <TextView
                android:id="@+id/tvRestaurantDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phở, Cơm, Mì • Quận 1"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="3dp" />

            <!-- Meta info: Time, Dist, Food Count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvRestaurantTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕒 20-30 phút"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="#CBD5E1" />

                <TextView
                    android:id="@+id/tvRestaurantDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 1.2 km"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="#CBD5E1" />

                <TextView
                    android:id="@+id/tvRestaurantFoodCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 món bán"
                    android:textColor="#DC2626"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- Bottom Action Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Đang hoạt động"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_status_green"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Edit Button -->
                <TextView
                    android:id="@+id/btnEditRestaurant"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="Sửa"
                    android:textColor="#2563EB"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_action_edit_sleek"
                    android:drawableStart="@drawable/ic_edit_blue"
                    android:drawablePadding="4dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Delete Button -->
                <TextView
                    android:id="@+id/btnDeleteRestaurant"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="Xóa"
                    android:textColor="#DC2626"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_action_delete_sleek"
                    android:drawableStart="@drawable/ic_delete_red"
                    android:drawablePadding="4dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
