<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llSizeRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_payment_card_normal"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivSizeRadio"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_radio_unchecked"
        android:contentDescription="Chọn size" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSizeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ổ Tiêu chuẩn"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSizeDeltaBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+8.000đ"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvSizePrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25.000đ"
        android:textColor="#E63946"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
