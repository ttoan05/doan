<?xml version="1.0" encoding="utf-8"?>
<!-- Nội dung tab Yêu thích, MainActivity inflate vào contentContainer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yêu thích"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"/>

            <TextView
                android:id="@+id/tvFavSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/text_grey"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnFavClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Xóa hết"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/red_primary"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Tab con: Món ăn / Nhà hàng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white">

        <LinearLayout
            android:id="@+id/tabFavFoods"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabFavFoods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Món ăn"
                android:textSize="14sp"/>

            <View
                android:id="@+id/vTabFavFoods"
                android:layout_width="match_parent"
                android:layout_height="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabFavRestaurants"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabFavRestaurants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Nhà hàng"
                android:textSize="14sp"/>

            <View
                android:id="@+id/vTabFavRestaurants"
                android:layout_width="match_parent"
                android:layout_height="3dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Ô tìm kiếm trong Yêu thích -->
    <EditText
        android:id="@+id/etFavSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search"
        android:hint="Tìm trong Yêu thích..."
        android:textColorHint="@color/text_grey"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:inputType="text"
        android:singleLine="true"
        android:imeOptions="actionSearch"/>

    <!-- Danh mục (chỉ tab Món ăn), nút thêm bằng code -->
    <HorizontalScrollView
        android:id="@+id/scrollFavCats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llFavCats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </HorizontalScrollView>

    <!-- Sắp xếp + Thêm tất cả vào giỏ -->
    <LinearLayout
        android:id="@+id/llFavToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnFavSort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_grey2"
            android:singleLine="true"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnFavAddAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="🛒 Thêm tất cả vào giỏ"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/red_primary"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Danh sách món yêu thích -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavFoods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="4dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"/>

    <!-- Danh sách nhà hàng yêu thích -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavRestaurants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"/>

    <!-- Lọc/tìm mà không ra kết quả -->
    <TextView
        android:id="@+id/tvFavNoResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="Không tìm thấy mục nào phù hợp"
        android:textSize="14sp"
        android:textColor="@color/text_grey"
        android:visibility="gone"/>

    <!-- Chưa có mục yêu thích nào -->
    <LinearLayout
        android:id="@+id/llFavEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤍"
            android:textSize="48sp"/>

        <TextView
            android:id="@+id/tvFavEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"/>

        <TextView
            android:id="@+id/tvFavEmptyDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="@color/text_grey"/>

        <Button
            android:id="@+id/btnFavExplore"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="@drawable/bg_btn_red"
            android:backgroundTint="@null"
            android:text="Khám phá món ngon"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>
    </LinearLayout>

    <!-- Gợi ý: Có thể bạn cũng thích -->
    <TextView
        android:id="@+id/tvFavSuggestTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavSuggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="16dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:visibility="gone"/>
</LinearLayout>
